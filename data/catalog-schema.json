{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["content_id", "title", "duration", "is_active", "genres"],
  "properties": {
    "content_id": { "type": "string", "pattern": "^vod_[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "duration": { "type": "integer", "minimum": 1 },
    "is_active": { "type": "boolean" },
    "genres": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "additionalProperties": false
}